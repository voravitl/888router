# Copy to .env and adjust for your environment.
# .env is git-ignored — never commit real secrets.

# --- Required ---

# SearXNG secret (used for its session/CSRF). Generate one:
#   openssl rand -hex 32
SEARXNG_SECRET=

# --- Optional ---

# Public origin used to absolutize skill markdown links.
# Local compose default: http://localhost:20128 (works when accessing the
# gateway on localhost). If the gateway is behind a reverse proxy / tunnel
# (e.g. https://888router.888router.orb.local or a VPS domain), set this to
# that PUBLIC host — otherwise served skill links point at localhost and
# remote agents cannot fetch them.
# NINEROUTER_PUBLIC_URL=http://localhost:20128
