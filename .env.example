# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.
#
# ── FIRST-TIME SETUP ────────────────────────────────────────────────
#   cp .env.example .env
#   edit .env — at minimum set the three REQUIRED values below
#   docker compose up -d
#
# The compose stack (888router + headroom + searxng) FAILS to start if
# SEARXNG_SECRET is unset — docker compose aborts with
#   "set SEARXNG_SECRET in .env"
# JWT_SECRET and INITIAL_PASSWORD are read at first boot; change them too.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# REQUIRED for the compose stack — SearXNG refuses to run with a known-in-git
# default (CSRF/session risk). Generate: openssl rand -hex 32
SEARXNG_SECRET=change-me-to-a-long-random-secret

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
# How many days of requestDetails to keep for the Savings report (24h/7d/30d).
# Time-based retention — older records are pruned on flush. Default 30.
# OBSERVABILITY_RETENTION_DAYS=30
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Time zone for usage stats (date grouping, "today" cutoff, chart labels)
# Without this, Node defaults to UTC — "today" starts at 07:00 TH time.
# For Docker: set via ENV in Dockerfile (needs tzdata apk).
# For process: export TZ=Asia/Bangkok before launch.
TZ=Asia/Bangkok

# Skills dashboard — public origin used to absolutize skill markdown links.
# Local compose default: http://localhost:20128 (works on localhost access).
# Behind a reverse proxy / tunnel (e.g. https://888router.888router.orb.local
# or a VPS domain), set this to the PUBLIC host — otherwise served skill
# links point at localhost and remote agents cannot fetch them.
NINEROUTER_PUBLIC_URL=http://localhost:20128

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
